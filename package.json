{
  "name": "dsh-sidebar-todo",
  "version": "0.3.1",
  "description": "DeepSeek Harness 侧栏待办清单：分组、循环任务、月视图日历、分类、便签坞与筛选，agent 可读写",
  "type": "module",
  "license": "MIT",
  "author": "Natte",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "todo",
    "todolist",
    "task",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natte/dsh-sidebar-todo.git"
  },
  "homepage": "https://github.com/Natte/dsh-sidebar-todo#readme",
  "bugs": {
    "url": "https://github.com/Natte/dsh-sidebar-todo/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "lib/**/*.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20", "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-locale"] }
  }
}
